@model AccountProfile
@{ ViewData["Title"] = "Account profile"; }
<section class="section"><div class="container"><div class="record-card"><h1>@Model.FullName</h1><p class="text-muted">@string.Join(", ", Model.Roles)</p><dl class="record-grid"><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Phone</dt><dd>@(Model.PhoneNumber ?? "Not provided")</dd></div></dl></div></div></section>
