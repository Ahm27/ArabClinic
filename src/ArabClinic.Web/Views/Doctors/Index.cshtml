@model IReadOnlyList<DoctorDto>
@{
    ViewData["Title"] = "Our Doctors";
    ViewData["BodyClass"] = "doctors-page";
    var specializations = ViewBag.Specializations as IReadOnlyList<SpecializationDto> ?? [];
    var selectedSpecId = ViewData["SelectedSpecializationId"] as int?;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Our Medical Specialists</h1>
            <p class="text-muted mb-0">Browse certified physicians, review clinical fees, and book direct appointments.</p>
        </div>
        <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary rounded-pill px-4 mt-2 mt-sm-0">
            <i class="bi bi-calendar-plus me-1"></i> Book Appointment
        </a>
    </div>

    <!-- Filter Pills by Specialization -->
    <div class="d-flex flex-wrap gap-2 mb-4 pb-2 border-bottom">
        <a asp-action="Index" class="btn btn-sm rounded-pill @(!selectedSpecId.HasValue ? "btn-primary" : "btn-outline-secondary")">
            All Doctors (@Model.Count)
        </a>
        @foreach (var spec in specializations)
        {
            <a asp-action="Index" asp-route-specializationId="@spec.SpecializationId"
               class="btn btn-sm rounded-pill @(selectedSpecId == spec.SpecializationId ? "btn-primary" : "btn-outline-secondary")">
                @spec.Name (@spec.DoctorCount)
            </a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-person-x fs-1 text-muted"></i>
            <h4 class="mt-3">No doctors found</h4>
            <p class="text-muted">No specialists match the selected criteria.</p>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill">View All Doctors</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @for (int i = 0; i < Model.Count; i++)
            {
                var doc = Model[i];
                var imgIndex = (i % 6) + 1;
                <div class="col-lg-4 col-md-6" data-aos="fade-up">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="position-relative">
                            <img src="~/assets/img/health/staff-@(imgIndex).webp" class="card-img-top object-fit-cover" style="height: 250px;" alt="@doc.FullName" />
                            <span class="badge bg-primary position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill">
                                @doc.SpecializationName
                            </span>
                        </div>
                        <div class="card-body p-4 d-flex flex-column">
                            <h4 class="fw-bold mb-1">@doc.FullName</h4>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1 text-primary"></i>@doc.Location</p>
                            <p class="text-muted small mb-3"><i class="bi bi-envelope me-1 text-primary"></i>@doc.Email</p>

                            <div class="bg-light rounded-3 p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">Consultation Fee</small>
                                    <span class="fw-bold text-primary fs-5">@doc.ConsultationFee.ToString("C0")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">Working Days</small>
                                    <span class="small fw-semibold text-dark">Mon – Fri</span>
                                </div>
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@doc.DoctorId" class="btn btn-primary rounded-pill flex-grow-1">
                                    Book Visit
                                </a>
                                <a asp-action="Details" asp-route-id="@doc.DoctorId" class="btn btn-outline-secondary rounded-pill px-3">
                                    Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
