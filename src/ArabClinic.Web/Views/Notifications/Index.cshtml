@model IReadOnlyList<NotificationDto>
@{
    ViewData["Title"] = "Notification Center";
    ViewData["BodyClass"] = "notifications-page";
    var unreadCount = ViewBag.UnreadCount as int? ?? 0;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Notification Center</h1>
            <p class="text-muted mb-0">Track patient alerts, appointment reminders, and channel delivery logs.</p>
        </div>
        <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">
            @unreadCount Unread Alert@(unreadCount == 1 ? "" : "s")
        </span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-bell-slash fs-1 text-muted"></i>
            <h4 class="mt-3">No notifications</h4>
            <p class="text-muted">You have no system or appointment notifications at this time.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var n in Model)
            {
                <div class="col-12" data-aos="fade-up">
                    <div class="card border-0 shadow-sm rounded-4 p-4 @(n.IsRead ? "bg-white" : "border-start border-4 border-primary bg-light")">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="d-flex gap-3">
                                <div class="bg-primary-subtle text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                    <i class="bi bi-bell-fill fs-4"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-1 @(n.IsRead ? "text-secondary" : "text-dark")">@n.Message</h5>
                                    <div class="d-flex flex-wrap gap-2 align-items-center small text-muted">
                                        <span><i class="bi bi-clock me-1"></i>@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                        <span>&bull;</span>
                                        <span>Recipient: <strong>@n.UserName</strong></span>
                                        @foreach (var log in n.DeliveryLogs)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi @(log.Channel == "Email" ? "bi-envelope" : "bi-phone") me-1"></i>
                                                @log.Channel: @log.DeliveryStatus
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkRead" asp-route-id="@n.NotificationId" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill text-nowrap">
                                        <i class="bi bi-check2 me-1"></i> Mark as Read
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border text-nowrap">Read</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
