@{
    ViewData["Title"] = "About ArabClinic";
    ViewData["BodyClass"] = "about-page";
}

<div class="container py-4">
    <div class="row align-items-center mb-5">
        <div class="col-lg-6" data-aos="fade-right">
            <span class="badge bg-primary-subtle text-primary py-2 px-3 rounded-pill fw-medium mb-3">About ArabClinic</span>
            <h1 class="display-5 fw-bold mb-3">Modern Compassionate Healthcare in Cairo</h1>
            <p class="lead text-secondary">
                ArabClinic was founded with a clear vision: to combine modern clinical standards with warm, patient-centered healthcare delivery.
            </p>
            <p class="text-muted">
                Our hospital is equipped with state-of-the-art diagnostic imaging, specialized outpatient clinics, digital health record infrastructure, and full-service specialized surgical departments.
            </p>
            <div class="row g-3 mt-2">
                <div class="col-sm-6">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-primary fs-4 me-2"></i>
                        <span class="fw-semibold">Certified Specialists</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-primary fs-4 me-2"></i>
                        <span class="fw-semibold">Digital Medical Records</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-primary fs-4 me-2"></i>
                        <span class="fw-semibold">24/7 Clinical Emergency</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-primary fs-4 me-2"></i>
                        <span class="fw-semibold">Transparent Billing</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6" data-aos="fade-left">
            <img src="~/assets/img/health/staff-11.webp" class="img-fluid rounded-4 shadow" alt="About ArabClinic" />
        </div>
    </div>
</div>
