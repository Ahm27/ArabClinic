@{
    ViewData["Title"] = "Compassionate Healthcare & Modern Clinic";
    ViewData["BodyClass"] = "index-page";
    var specializations = ViewBag.Specializations as IReadOnlyList<SpecializationDto> ?? [];
    var doctors = ViewBag.Doctors as IReadOnlyList<DoctorDto> ?? [];
}

<!-- Hero Section -->
<section id="hero" class="hero section py-5">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <div class="hero-content">
                    <div class="trust-badges mb-4 d-flex gap-3 flex-wrap" data-aos="fade-right" data-aos-delay="200">
                        <span class="badge bg-primary-subtle text-primary py-2 px-3 rounded-pill fw-medium"><i class="bi bi-shield-check me-1"></i> ISO Accredited Clinic</span>
                        <span class="badge bg-success-subtle text-success py-2 px-3 rounded-pill fw-medium"><i class="bi bi-clock me-1"></i> 24/7 Emergency Care</span>
                        <span class="badge bg-warning-subtle text-dark py-2 px-3 rounded-pill fw-medium"><i class="bi bi-star-fill text-warning me-1"></i> 4.9/5 Patient Satisfaction</span>
                    </div>

                    <h1 class="display-5 fw-bold mb-3" data-aos="fade-right" data-aos-delay="300">
                        Excellence in <span class="text-primary">Healthcare</span> With Compassionate Care
                    </h1>

                    <p class="lead text-secondary mb-4" data-aos="fade-right" data-aos-delay="400">
                        ArabClinic brings expert physicians, streamlined appointments, integrated electronic medical records, and transparent billing together in one harmonious experience.
                    </p>

                    <div class="d-flex flex-wrap gap-3 mb-4" data-aos="fade-right" data-aos-delay="500">
                        <div class="border rounded-3 p-3 bg-light text-center min-w-100">
                            <h3 class="fw-bold text-primary mb-0">15+</h3>
                            <small class="text-muted">Years Experience</small>
                        </div>
                        <div class="border rounded-3 p-3 bg-light text-center min-w-100">
                            <h3 class="fw-bold text-primary mb-0">5,000+</h3>
                            <small class="text-muted">Patients Treated</small>
                        </div>
                        <div class="border rounded-3 p-3 bg-light text-center min-w-100">
                            <h3 class="fw-bold text-primary mb-0">50+</h3>
                            <small class="text-muted">Medical Specialists</small>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3" data-aos="fade-right" data-aos-delay="600">
                        <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary btn-lg rounded-pill px-4">
                            <i class="bi bi-calendar-check me-2"></i> Book Appointment Now
                        </a>
                        <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-primary btn-lg rounded-pill px-4">
                            <i class="bi bi-person-badge me-2"></i> Meet Our Doctors
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="position-relative text-center" data-aos="fade-left" data-aos-delay="300">
                    <img src="~/assets/img/health/staff-10.webp" alt="ArabClinic Medical Team" class="img-fluid rounded-4 shadow-lg" />
                    <div class="card shadow-sm border-0 position-absolute bottom-0 start-0 m-3 p-3 bg-white text-start rounded-3 d-none d-sm-block" style="max-width: 250px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                <i class="bi bi-clock-history fs-5"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Instant Booking</small>
                                <span class="fw-bold text-dark">Same-Day Slots</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Quick Action Modules -->
<section class="section py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h6 class="text-primary fw-bold text-uppercase">Clinic Workspace</h6>
            <h2 class="fw-bold">Everything You Need In One System</h2>
            <p class="text-muted">Explore clinical appointments, specialty departments, patient records, and diagnostics.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4 hover-lift">
                    <div class="text-primary fs-1 mb-3"><i class="bi bi-calendar-event"></i></div>
                    <h4 class="fw-bold">Appointments</h4>
                    <p class="text-muted small">Schedule visits, check real-time doctor availability, avoid conflicting slots.</p>
                    <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">View Schedule &rarr;</a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4 hover-lift">
                    <div class="text-primary fs-1 mb-3"><i class="bi bi-person-heart"></i></div>
                    <h4 class="fw-bold">Doctors</h4>
                    <p class="text-muted small">Qualified physicians with consultation fee details, weekly hours, and locations.</p>
                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">View Doctors &rarr;</a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4 hover-lift">
                    <div class="text-primary fs-1 mb-3"><i class="bi bi-hospital"></i></div>
                    <h4 class="fw-bold">Departments</h4>
                    <p class="text-muted small">Comprehensive care across Cardiology, Neurology, Pediatrics, Orthopedics & more.</p>
                    <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">Departments &rarr;</a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4 hover-lift">
                    <div class="text-primary fs-1 mb-3"><i class="bi bi-people"></i></div>
                    <h4 class="fw-bold">Patients</h4>
                    <p class="text-muted small">Patient registration, medical histories, allergies, and ongoing treatment tracking.</p>
                    <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">Patient Portal &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Departments Section -->
<section class="section py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4" data-aos="fade-up">
            <div>
                <h6 class="text-primary fw-bold text-uppercase">Specialties</h6>
                <h2 class="fw-bold mb-0">Our Clinical Departments</h2>
            </div>
            <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-primary rounded-pill">View All Departments</a>
        </div>

        <div class="row g-4">
            @foreach (var spec in specializations.Take(4))
            {
                <div class="col-lg-3 col-md-6" data-aos="fade-up">
                    <div class="card h-100 border rounded-4 p-4 shadow-sm">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary-subtle text-primary p-3 rounded-circle me-3">
                                <i class="bi bi-heart-pulse fs-3"></i>
                            </div>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">@spec.DoctorCount Doctors</span>
                        </div>
                        <h4 class="fw-bold">@spec.Name</h4>
                        <p class="text-muted small flex-grow-1">@spec.Description</p>
                        <a asp-controller="Departments" asp-action="Details" asp-route-id="@spec.SpecializationId" class="text-primary text-decoration-none fw-semibold">
                            Explore Department &rarr;
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Doctors Section -->
<section class="section py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4" data-aos="fade-up">
            <div>
                <h6 class="text-primary fw-bold text-uppercase">Medical Team</h6>
                <h2 class="fw-bold mb-0">Meet Our Specialists</h2>
            </div>
            <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-primary rounded-pill">View All Doctors</a>
        </div>

        <div class="row g-4">
            @for (int i = 0; i < doctors.Count; i++)
            {
                var doc = doctors[i];
                var imgIndex = (i % 6) + 1;
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="@(i * 100)">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <img src="~/assets/img/health/staff-@(imgIndex).webp" class="card-img-top object-fit-cover" style="height: 230px;" alt="@doc.FullName" />
                        <div class="card-body p-4 d-flex flex-column">
                            <span class="badge bg-primary-subtle text-primary mb-2 align-self-start">@doc.SpecializationName</span>
                            <h5 class="fw-bold mb-1">@doc.FullName</h5>
                            <small class="text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@doc.Location</small>
                            <p class="text-primary fw-bold fs-5 mb-3">@doc.ConsultationFee.ToString("C0") <small class="text-muted fw-normal fs-6">/ consultation</small></p>
                            <div class="mt-auto d-grid gap-2">
                                <a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@doc.DoctorId" class="btn btn-primary rounded-pill btn-sm">Book Appointment</a>
                                <a asp-controller="Doctors" asp-action="Details" asp-route-id="@doc.DoctorId" class="btn btn-outline-secondary rounded-pill btn-sm">Doctor Profile</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Emergency / CTA Banner -->
<section class="section py-5 bg-primary text-white">
    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-lg-8 mb-4 mb-lg-0">
                <h2 class="fw-bold display-6 mb-2">Need Immediate Clinical Assistance?</h2>
                <p class="lead mb-0 text-white-50">Our emergency desk and on-call specialist doctors are available 24 hours a day, 7 days a week.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-controller="Appointments" asp-action="Create" class="btn btn-light btn-lg text-primary fw-bold rounded-pill px-4 me-2">
                    Schedule Now
                </a>
                <a href="tel:+201000000000" class="btn btn-outline-light btn-lg rounded-pill px-4">
                    <i class="bi bi-telephone-fill me-1"></i> Call Clinic
                </a>
            </div>
        </div>
    </div>
</section>
