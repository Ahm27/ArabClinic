@model CreateMedicalRecordViewModel
@{
    ViewData["Title"] = $"Add Medical Record for Appointment #{Model.AppointmentId}";
    ViewData["BodyClass"] = "medical-records-page";
    var app = ViewBag.Appointment as AppointmentDetailsDto;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Appointments" asp-action="Index">Appointments</a></li>
            <li class="breadcrumb-item"><a asp-controller="Appointments" asp-action="Details" asp-route-id="@Model.AppointmentId">Appointment #@Model.AppointmentId</a></li>
            <li class="breadcrumb-item active" aria-current="page">Add Medical Record</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-9 mx-auto">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="mb-4">
                    <span class="badge bg-primary-subtle text-primary py-2 px-3 rounded-pill fw-medium mb-2">Clinical Documentation</span>
                    <h2 class="fw-bold">Create Medical Record</h2>
                    @if (app != null)
                    {
                        <p class="text-muted">Recording diagnosis and prescription for <strong>@app.PatientName</strong> with <strong>@app.DoctorName</strong> (@app.SpecializationName).</p>
                    }
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-4 mb-4" role="alert">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="AppointmentId" />

                    <!-- Diagnosis & Symptoms -->
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-file-earmark-medical me-2"></i> Diagnosis & Examination</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label asp-for="Diagnosis" class="form-label fw-semibold">Primary Diagnosis <span class="text-danger">*</span></label>
                            <input asp-for="Diagnosis" class="form-control form-control-lg rounded-3" placeholder="e.g. Acute Bronchitis, Migraine without aura" required />
                        </div>
                        <div class="col-12">
                            <label asp-for="Symptoms" class="form-label fw-semibold">Presenting Symptoms</label>
                            <textarea asp-for="Symptoms" class="form-control rounded-3" rows="3" placeholder="Patient's reported symptoms and complaints..."></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="TreatmentNotes" class="form-label fw-semibold">Treatment Notes & Recommendations</label>
                            <textarea asp-for="TreatmentNotes" class="form-control rounded-3" rows="3" placeholder="Clinical instructions, follow-up advice, dietary guidelines..."></textarea>
                        </div>
                    </div>

                    <!-- Prescriptions (Item 1 & 2) -->
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-capsule me-2"></i> Prescribe Medications (Optional)</h5>
                    
                    <div class="p-3 bg-light rounded-4 mb-3">
                        <h6 class="fw-bold mb-3 text-secondary">Medication #1</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Medication Name</label>
                                <input asp-for="MedicationName1" class="form-control rounded-3" placeholder="e.g. Amoxicillin 500mg" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Dosage</label>
                                <input asp-for="Dosage1" class="form-control rounded-3" placeholder="1 capsule" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Frequency</label>
                                <input asp-for="Frequency1" class="form-control rounded-3" placeholder="Every 8 hrs" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Duration</label>
                                <input asp-for="Duration1" class="form-control rounded-3" placeholder="7 days" />
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-4 mb-4">
                        <h6 class="fw-bold mb-3 text-secondary">Medication #2</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Medication Name</label>
                                <input asp-for="MedicationName2" class="form-control rounded-3" placeholder="e.g. Paracetamol 500mg" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Dosage</label>
                                <input asp-for="Dosage2" class="form-control rounded-3" placeholder="1 tablet" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Frequency</label>
                                <input asp-for="Frequency2" class="form-control rounded-3" placeholder="As needed" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Duration</label>
                                <input asp-for="Duration2" class="form-control rounded-3" placeholder="5 days" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 pt-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold">
                            <i class="bi bi-check-lg me-2"></i> Save Record & Complete Visit
                        </button>
                        <a asp-controller="Appointments" asp-action="Details" asp-route-id="@Model.AppointmentId" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
