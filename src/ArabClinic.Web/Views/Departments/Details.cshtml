@model SpecializationDto
@{
    ViewData["Title"] = $"{Model.Name} Department";
    ViewData["BodyClass"] = "departments-page";
    var doctors = ViewBag.Doctors as IReadOnlyList<DoctorDto> ?? [];
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Departments</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Department Header Banner -->
    <div class="card border-0 bg-primary text-white rounded-4 shadow-sm p-4 p-md-5 mb-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-white text-primary py-2 px-3 rounded-pill fw-bold mb-3">Department Profile</span>
                <h1 class="display-5 fw-bold mb-3">@Model.Name Department</h1>
                <p class="lead mb-0 text-white-50">@Model.Description</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <a asp-controller="Appointments" asp-action="Create" class="btn btn-light btn-lg text-primary fw-bold rounded-pill px-4">
                    <i class="bi bi-calendar-check me-2"></i> Book in this Department
                </a>
            </div>
        </div>
    </div>

    <!-- Doctors in this Department -->
    <h3 class="fw-bold mb-4">Specialists in @Model.Name (@doctors.Count)</h3>

    @if (doctors.Count == 0)
    {
        <div class="text-center py-5">
            <p class="text-muted">No physicians currently assigned to this department.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @for (int i = 0; i < doctors.Count; i++)
            {
                var doc = doctors[i];
                var imgIndex = (i % 6) + 1;
                <div class="col-lg-4 col-md-6" data-aos="fade-up">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <img src="~/assets/img/health/staff-@(imgIndex).webp" class="card-img-top object-fit-cover" style="height: 220px;" alt="@doc.FullName" />
                        <div class="card-body p-4 d-flex flex-column">
                            <h4 class="fw-bold mb-1">@doc.FullName</h4>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1 text-primary"></i>@doc.Location</p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted small">Consultation Fee</span>
                                <strong class="text-primary fs-5">@doc.ConsultationFee.ToString("C0")</strong>
                            </div>
                            <div class="mt-auto d-flex gap-2">
                                <a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@doc.DoctorId" class="btn btn-primary rounded-pill flex-grow-1">
                                    Book Appointment
                                </a>
                                <a asp-controller="Doctors" asp-action="Details" asp-route-id="@doc.DoctorId" class="btn btn-outline-secondary rounded-pill px-3">
                                    Profile
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
