@model IReadOnlyList<InvoiceDetailsDto>
@{
    ViewData["Title"] = "Billing & Invoices";
    ViewData["BodyClass"] = "billing-page";
    var currentStatus = ViewData["CurrentStatus"] as string ?? "All";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Clinic Invoices & Billing</h1>
            <p class="text-muted mb-0">Manage consultation fees, track pending balances, and record payments.</p>
        </div>
    </div>

    <!-- Filter Buttons -->
    <div class="d-flex flex-wrap gap-2 mb-4 pb-2 border-bottom">
        <a asp-action="Index" class="btn btn-sm rounded-pill @(currentStatus == "All" ? "btn-primary" : "btn-outline-secondary")">
            All Invoices (@Model.Count)
        </a>
        <a asp-action="Index" asp-route-status="Unpaid" class="btn btn-sm rounded-pill @(currentStatus == "Unpaid" ? "btn-primary" : "btn-outline-secondary")">
            <i class="bi bi-exclamation-circle me-1"></i> Unpaid
        </a>
        <a asp-action="Index" asp-route-status="Paid" class="btn btn-sm rounded-pill @(currentStatus == "Paid" ? "btn-primary" : "btn-outline-secondary")">
            <i class="bi bi-check-circle me-1"></i> Paid
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-receipt-cutoff fs-1 text-muted"></i>
            <h4 class="mt-3">No invoices found</h4>
            <p class="text-muted">No invoices match the selected filter.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Invoice #</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Issued Date</th>
                            <th>Total Amount</th>
                            <th>Paid Amount</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model)
                        {
                            var badgeClass = inv.Status switch
                            {
                                "Paid" => "bg-success-subtle text-success",
                                "Unpaid" => "bg-warning-subtle text-warning-emphasis",
                                "PartiallyPaid" => "bg-info-subtle text-info-emphasis",
                                _ => "bg-secondary-subtle text-secondary"
                            };

                            <tr>
                                <td class="ps-4 fw-bold">#@inv.InvoiceId</td>
                                <td>
                                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@inv.PatientId" class="text-dark fw-bold text-decoration-none">
                                        @inv.PatientName
                                    </a>
                                </td>
                                <td>@inv.DoctorName</td>
                                <td>@inv.IssuedAt.ToString("MMM dd, yyyy")</td>
                                <td class="fw-bold">@inv.TotalAmount.ToString("C0")</td>
                                <td class="text-success fw-semibold">@inv.PaidAmount.ToString("C0")</td>
                                <td class="@(inv.RemainingBalance > 0 ? "text-danger fw-bold" : "text-muted")">
                                    @inv.RemainingBalance.ToString("C0")
                                </td>
                                <td>
                                    <span class="badge @badgeClass rounded-pill px-3 py-2">@inv.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@inv.InvoiceId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        View & Pay
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
