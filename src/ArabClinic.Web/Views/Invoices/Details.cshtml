@model InvoiceDetailsDto
@{
    ViewData["Title"] = $"Invoice #{Model.InvoiceId}";
    ViewData["BodyClass"] = "billing-page";
    var badgeClass = Model.Status switch
    {
        "Paid" => "bg-success text-white",
        "Unpaid" => "bg-warning text-dark",
        "PartiallyPaid" => "bg-info text-white",
        _ => "bg-secondary text-white"
    };
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Billing</a></li>
            <li class="breadcrumb-item active" aria-current="page">Invoice #@Model.InvoiceId</li>
        </ol>
    </nav>

    @if (TempData["PaymentSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["PaymentSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["PaymentError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["PaymentError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Invoice Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <span class="badge bg-primary-subtle text-primary py-2 px-3 rounded-pill fw-medium mb-2">Clinic Billing Statement</span>
                <div class="d-flex align-items-center gap-3">
                    <h2 class="fw-bold mb-0">Invoice #@Model.InvoiceId</h2>
                    <span class="badge @badgeClass rounded-pill px-3 py-2 fs-6">@Model.Status</span>
                </div>
                <p class="text-muted mb-0 mt-1">
                    Issued on @Model.IssuedAt.ToString("MMMM dd, yyyy") for
                    <a asp-controller="Appointments" asp-action="Details" asp-route-id="@Model.AppointmentId" class="fw-semibold text-decoration-none">
                        Appointment #@Model.AppointmentId
                    </a>
                </p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 mt-3 mt-sm-0">
                &larr; Back to Billing List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Summary Cards -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center mb-4">
                <small class="text-muted fw-bold text-uppercase">Total Amount</small>
                <h2 class="fw-bold text-dark my-2">@Model.TotalAmount.ToString("C0")</h2>
                <small class="text-muted">Physician Consultation</small>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 text-center mb-4">
                <small class="text-muted fw-bold text-uppercase">Paid to Date</small>
                <h2 class="fw-bold text-success my-2">@Model.PaidAmount.ToString("C0")</h2>
                <small class="text-muted">Processed Payments</small>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 text-center mb-4 @(Model.RemainingBalance > 0 ? "border border-warning" : "")">
                <small class="text-muted fw-bold text-uppercase">Remaining Balance</small>
                <h2 class="fw-bold @(Model.RemainingBalance > 0 ? "text-danger" : "text-muted") my-2">
                    @Model.RemainingBalance.ToString("C0")
                </h2>
                <small class="text-muted">Due Upon Service</small>
            </div>

            <!-- Record Payment Form if Balance Remaining -->
            @if (Model.RemainingBalance > 0)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-credit-card text-primary me-2"></i> Process Payment</h5>
                    <form asp-action="Pay" method="post">
                        <input type="hidden" name="InvoiceId" value="@Model.InvoiceId" />
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Payment Amount</label>
                            <input type="number" step="0.01" min="1" max="@Model.RemainingBalance" name="Amount" value="@Model.RemainingBalance" class="form-control rounded-3" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Payment Method</label>
                            <select name="PaymentMethod" class="form-select rounded-3">
                                <option value="Credit Card">Credit Card</option>
                                <option value="Cash">Cash</option>
                                <option value="Insurance">Insurance / Healthcare Plan</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Transaction / Receipt Reference (Optional)</label>
                            <input type="text" name="TransactionReference" class="form-control rounded-3" placeholder="e.g. REC-892301" />
                        </div>
                        <button type="submit" class="btn btn-primary rounded-pill w-100 py-2 fw-semibold">
                            Record Payment
                        </button>
                    </form>
                </div>
            }
        </div>

        <div class="col-lg-8">
            <!-- Details Overview -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i> Consultation Details</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="text-muted small mb-1">Patient</p>
                        <h6 class="fw-bold">
                            <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" class="text-dark text-decoration-none">
                                @Model.PatientName
                            </a>
                        </h6>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted small mb-1">Consulting Physician</p>
                        <h6 class="fw-bold">@Model.DoctorName</h6>
                    </div>
                </div>
            </div>

            <!-- Payments List -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-cash-stack text-primary me-2"></i> Payments Recorded (@Model.Payments.Count)</h5>
                @if (Model.Payments.Count == 0)
                {
                    <p class="text-muted mb-0">No payments recorded for this invoice yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Method</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Reference</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Payments)
                                {
                                    <tr>
                                        <td>@p.PaidAt.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td><span class="badge bg-light text-dark border">@p.PaymentMethod</span></td>
                                        <td class="fw-bold text-success">@p.Amount.ToString("C0")</td>
                                        <td><span class="badge bg-success-subtle text-success">@p.PaymentStatus</span></td>
                                        <td><code>@(string.IsNullOrWhiteSpace(p.TransactionReference) ? "–" : p.TransactionReference)</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
