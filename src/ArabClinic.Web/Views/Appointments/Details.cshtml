@model AppointmentDetailsDto
@{
    ViewData["Title"] = $"Appointment #{Model.AppointmentId}";
    ViewData["BodyClass"] = "appointment-page";
    var statusBadge = Model.Status switch
    {
        "Completed" => "bg-success",
        "Scheduled" => "bg-primary",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Appointments</a></li>
            <li class="breadcrumb-item active" aria-current="page">Appointment #@Model.AppointmentId</li>
        </ol>
    </nav>

    @if (TempData["AppointmentSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["AppointmentSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AppointmentError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["AppointmentError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Appointment Header -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <div class="d-flex align-items-center gap-3 mb-2">
                    <h2 class="fw-bold mb-0">Appointment #@Model.AppointmentId</h2>
                    <span class="badge @statusBadge fs-6 rounded-pill px-3 py-2">@Model.Status</span>
                </div>
                <p class="text-muted mb-0">
                    <i class="bi bi-calendar3 me-1"></i> @Model.StartDateTime.ToString("dddd, MMMM dd, yyyy") &nbsp;|&nbsp;
                    <i class="bi bi-clock me-1"></i> @Model.StartDateTime.ToString("hh:mm tt") – @Model.EndDateTime.ToString("hh:mm tt")
                </p>
            </div>
            <div class="d-flex gap-2 mt-3 mt-sm-0">
                @if ((Model.Status == "Scheduled" || Model.Status == "Pending") && (User.IsInRole("Doctor") || User.IsInRole("Admin")))
                {
                    <form asp-action="ChangeStatus" asp-route-id="@Model.AppointmentId" method="post" class="d-inline"><input type="hidden" name="status" value="Confirmed"/><button type="submit" class="btn btn-success rounded-pill px-4"><i class="bi bi-check2 me-1"></i> Confirm</button></form>
                    <form asp-action="ChangeStatus" asp-route-id="@Model.AppointmentId" method="post" class="d-inline"><input type="hidden" name="status" value="Rejected"/><button type="submit" class="btn btn-outline-danger rounded-pill px-4"><i class="bi bi-x me-1"></i> Reject</button></form>
                }
                @if (Model.Status == "Confirmed" && (User.IsInRole("Doctor") || User.IsInRole("Admin")))
                {
                    <form asp-action="Complete" asp-route-id="@Model.AppointmentId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-success rounded-pill px-3">
                            <i class="bi bi-check2-circle me-1"></i> Mark Completed
                        </button>
                    </form>
                }
                @if ((Model.Status is "Scheduled" or "Pending" or "Confirmed") && (User.IsInRole("Patient") || User.IsInRole("Admin")))
                {
                    <form asp-action="Cancel" asp-route-id="@Model.AppointmentId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3">
                            <i class="bi bi-x-circle me-1"></i> Cancel Visit
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Patient & Doctor Overview -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h4 class="fw-bold mb-3"><i class="bi bi-person-fill text-primary me-2"></i> Patient Information</h4>
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle me-3">
                        <i class="bi bi-person fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">
                            <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" class="text-dark text-decoration-none">
                                @Model.PatientName
                            </a>
                        </h5>
                        <small class="text-muted">ID: @Model.PatientId</small>
                    </div>
                </div>
                <ul class="list-unstyled mb-0">
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Email:</span>
                        <strong>@(Model.PatientEmail ?? "Not provided")</strong>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Phone:</span>
                        <strong>@(Model.PatientPhone ?? "Not provided")</strong>
                    </li>
                    <li class="py-2 d-flex justify-content-between">
                        <span class="text-muted">Notes / Reason:</span>
                        <span class="text-end">@(string.IsNullOrWhiteSpace(Model.Notes) ? "None specified" : Model.Notes)</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h4 class="fw-bold mb-3"><i class="bi bi-heart-pulse-fill text-primary me-2"></i> Doctor & Clinical Room</h4>
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary text-white p-3 rounded-circle me-3">
                        <i class="bi bi-person-badge fs-3"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">
                            <a asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.DoctorId" class="text-dark text-decoration-none">
                                @Model.DoctorName
                            </a>
                        </h5>
                        <span class="badge bg-primary-subtle text-primary">@Model.SpecializationName</span>
                    </div>
                </div>
                <ul class="list-unstyled mb-0">
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Clinic Location:</span>
                        <strong>@Model.DoctorLocation</strong>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Consultation Fee:</span>
                        <strong class="text-primary fs-5">@Model.ConsultationFee.ToString("C0")</strong>
                    </li>
                    <li class="py-2 d-flex justify-content-between">
                        <span class="text-muted">Created On:</span>
                        <span>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Medical Record Section -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0"><i class="bi bi-clipboard2-pulse text-primary me-2"></i> Medical Record</h4>
                    @if (Model.MedicalRecord == null)
                    {
                        <a asp-controller="MedicalRecords" asp-action="Create" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-sm btn-primary rounded-pill">
                            <i class="bi bi-plus-circle me-1"></i> Add Record
                        </a>
                    }
                </div>

                @if (Model.MedicalRecord != null)
                {
                    <div class="bg-light rounded-4 p-3 mb-3">
                        <div class="fw-bold text-dark fs-5 mb-1">@Model.MedicalRecord.Diagnosis</div>
                        <p class="text-muted small mb-2">@Model.MedicalRecord.TreatmentNotes</p>
                        <div class="d-flex gap-2">
                            <span class="badge bg-primary-subtle text-primary rounded-pill">
                                <i class="bi bi-capsule me-1"></i> @Model.MedicalRecord.PrescriptionCount Prescription(s)
                            </span>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                                <i class="bi bi-file-earmark-pdf me-1"></i> @Model.MedicalRecord.DocumentCount Document(s)
                            </span>
                        </div>
                    </div>
                    <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@Model.MedicalRecord.MedicalRecordId" class="btn btn-outline-primary rounded-pill w-100">
                        View Complete Medical Record &rarr;
                    </a>
                }
                else
                {
                    <p class="text-muted">No diagnostic record has been entered for this consultation yet.</p>
                }
            </div>
        </div>

        <!-- Billing / Invoice Section -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0"><i class="bi bi-receipt text-primary me-2"></i> Billing & Invoice</h4>
                    @if (Model.Invoice != null)
                    {
                        <span class="badge @(Model.Invoice.Status == "Paid" ? "bg-success" : "bg-warning text-dark") rounded-pill px-3 py-2">
                            @Model.Invoice.Status
                        </span>
                    }
                </div>

                @if (Model.Invoice != null)
                {
                    <div class="bg-light rounded-4 p-3 mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total Amount:</span>
                            <strong class="fs-5">@Model.Invoice.TotalAmount.ToString("C0")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Amount Paid:</span>
                            <span class="text-success fw-bold">@Model.Invoice.PaidAmount.ToString("C0")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Issued Date:</span>
                            <span class="text-muted">@Model.Invoice.IssuedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                    <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.Invoice.InvoiceId" class="btn btn-outline-primary rounded-pill w-100">
                        View Invoice & Record Payment &rarr;
                    </a>
                }
            </div>
        </div>

        <!-- Status History Timeline -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-clock-history text-primary me-2"></i> Status Transition History</h4>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Timestamp</th>
                                <th>Previous Status</th>
                                <th>New Status</th>
                                <th>Changed By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.StatusHistories)
                            {
                                <tr>
                                    <td>@h.ChangedAt.ToString("MMM dd, yyyy HH:mm:ss")</td>
                                    <td>@(h.OldStatus ?? "Initial Creation")</td>
                                    <td><span class="badge bg-secondary rounded-pill">@h.NewStatus</span></td>
                                    <td>@h.ChangedByUserName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
