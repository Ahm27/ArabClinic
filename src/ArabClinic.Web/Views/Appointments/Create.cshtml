@model AppointmentViewModel
@{
    ViewData["Title"] = "Book an Appointment";
    ViewData["BodyClass"] = "appointment-page";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="badge bg-primary-subtle text-primary py-2 px-3 rounded-pill fw-medium mb-2">Easy Clinical Scheduling</span>
                    <h2 class="fw-bold">Schedule Your Appointment</h2>
                    <p class="text-muted">Book your medical consultation in just a few simple steps. Our specialists are ready to provide you with the best care.</p>
                </div>

                <!-- 3 Step Indicators from Template -->
                <div class="row g-3 text-center mb-4 pb-3 border-bottom">
                    <div class="col-4">
                        <div class="p-2 rounded bg-light">
                            <i class="bi bi-person-badge text-primary fs-4"></i>
                            <div class="small fw-bold mt-1">1. Choose Doctor</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded bg-light">
                            <i class="bi bi-clock text-primary fs-4"></i>
                            <div class="small fw-bold mt-1">2. Pick Slot</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded bg-light">
                            <i class="bi bi-check2-circle text-primary fs-4"></i>
                            <div class="small fw-bold mt-1">3. Confirm</div>
                        </div>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-4 mb-4" role="alert">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Create" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold">Patient Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control form-control-lg rounded-3" placeholder="e.g. Mahmoud Youssef" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control form-control-lg rounded-3" placeholder="you@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control form-control-lg rounded-3" placeholder="+20 100 000 0000" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DoctorId" class="form-label fw-semibold">Specialist Doctor <span class="text-danger">*</span></label>
                            <select asp-for="DoctorId" asp-items="Model.DoctorOptions" class="form-select form-select-lg rounded-3">
                                <option value="">-- Choose Specialist Doctor --</option>
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PreferredDate" class="form-label fw-semibold">Appointment Date <span class="text-danger">*</span></label>
                            <input asp-for="PreferredDate" class="form-control form-control-lg rounded-3" type="date" />
                            <span asp-validation-for="PreferredDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PreferredTime" class="form-label fw-semibold">Preferred Time <span class="text-danger">*</span></label>
                            <input asp-for="PreferredTime" class="form-control form-control-lg rounded-3" type="time" />
                            <span asp-validation-for="PreferredTime" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold">Symptoms / Medical Reason (Optional)</label>
                            <textarea asp-for="Notes" class="form-control rounded-3" rows="3" placeholder="Describe current symptoms or specific assistance required..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="col-12 pt-3">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 py-3 fw-bold">
                                <i class="bi bi-calendar-check me-2"></i> Book Appointment Now
                            </button>
                        </div>
                    </div>
                </form>

                <div class="text-center mt-4 pt-3 border-top text-muted small">
                    <i class="bi bi-shield-lock me-1"></i> No account required. Your consultation invoice will be generated upon booking.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
