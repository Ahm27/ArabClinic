@model PatientDetailsViewModel
@{ ViewData["Title"] = "Delete patient"; ViewData["BodyClass"] = "patients-page"; }
<partial name="_PageTitle" model='("Delete patient", "Confirm before permanently removing this patient record.")' />
<section class="section"><div class="container"><div class="booking-card delete-card"><div class="delete-icon"><i class="bi bi-archive"></i></div><h2>Archive @Model.FullName?</h2><p>The patient will disappear from active lists, while appointments and clinical history remain preserved.</p><dl class="record-grid"><div><dt>Date of birth</dt><dd>@Model.DateOfBirth.ToString("dd MMMM yyyy")</dd></div></dl><form method="post"><button type="submit" class="btn btn-danger btn-lg">Archive patient</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light btn-lg">Cancel</a></form></div></div></section>
