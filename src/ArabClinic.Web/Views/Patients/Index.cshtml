@model IReadOnlyList<PatientListItemViewModel>
@{
    ViewData["Title"] = "Patients Directory";
    ViewData["BodyClass"] = "patients-page";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Patient Directory</h1>
            <p class="text-muted mb-0">Total of @Model.Count registered patient record@(Model.Count == 1 ? "" : "s").</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 mt-2 mt-sm-0">
            <i class="bi bi-person-plus me-1"></i> Register New Patient
        </a>
    </div>

    @if (TempData["PatientMessage"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-people fs-1 text-muted"></i>
            <h4 class="mt-3">No patients yet</h4>
            <p class="text-muted">Register a patient record to begin managing care.</p>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4">Register First Patient</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Patient Name</th>
                            <th>Date of Birth</th>
                            <th>Gender</th>
                            <th>Address</th>
                            <th>Allergies</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@patient.Id" class="fw-bold text-dark text-decoration-none d-flex align-items-center gap-2">
                                        <div class="bg-primary-subtle text-primary rounded-circle fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                            @patient.FullName[0]
                                        </div>
                                        <span>@patient.FullName</span>
                                    </a>
                                </td>
                                <td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@patient.Gender</span></td>
                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(patient.Address) ? "–" : patient.Address)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(patient.Allergies) && !patient.Allergies.Equals("None", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill"><i class="bi bi-exclamation-triangle me-1"></i>@patient.Allergies</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                        <a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
