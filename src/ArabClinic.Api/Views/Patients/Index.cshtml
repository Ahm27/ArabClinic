@model IReadOnlyList<PatientListItemViewModel>
@{ ViewData["Title"] = "Patients"; ViewData["BodyClass"] = "patients-page"; }
<partial name="_PageTitle" model='("Patients", "Find and manage patient records from one clinic workspace.")' />
<section class="section"><div class="container">
@if (TempData["PatientMessage"] is string message) { <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@message</div> }
<div class="workspace-toolbar"><div><h2>Patient directory</h2><p>@Model.Count patient record@(Model.Count == 1 ? "" : "s")</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-2"></i>Add patient</a></div>
@if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon"><i class="bi bi-people"></i></div><h3>No patients yet</h3><p>Create the first patient record to begin managing care.</p><a asp-action="Create" class="btn btn-primary">Add first patient</a></div> }
else { <div class="patient-table-card"><div class="table-responsive"><table class="table patient-table align-middle mb-0"><thead><tr><th>Patient</th><th>Date of birth</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach (var patient in Model) { <tr><td><a asp-action="Details" asp-route-id="@patient.Id" class="patient-name"><span class="patient-avatar">@patient.FullName[0]</span><span>@patient.FullName</span></a></td><td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td><td class="text-end"><div class="btn-group"><a asp-action="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-secondary">View</a><a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">Edit</a><a asp-action="Delete" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-danger">Delete</a></div></td></tr> }
</tbody></table></div></div> }
</div></section>
