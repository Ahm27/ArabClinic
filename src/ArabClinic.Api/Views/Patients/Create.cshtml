@model PatientFormViewModel
@{ ViewData["Title"] = "Add patient"; ViewData["BodyClass"] = "patients-page"; }
<partial name="_PageTitle" model='("Add patient", "Create a new patient record with the essential details.")' />
<section class="section"><div class="container"><div class="booking-card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><partial name="_PatientForm" model="Model" /><div class="form-actions"><button type="submit" class="btn btn-primary btn-lg">Create patient</button><a asp-action="Index" class="btn btn-light btn-lg">Cancel</a></div></form></div></div></section>
