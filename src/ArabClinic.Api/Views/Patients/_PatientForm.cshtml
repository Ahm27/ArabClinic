@model PatientFormViewModel
<div class="row g-4"><div class="col-12"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Patient’s full name" /><span asp-validation-for="FullName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" class="form-control" /><span asp-validation-for="DateOfBirth" class="text-danger"></span></div></div>
