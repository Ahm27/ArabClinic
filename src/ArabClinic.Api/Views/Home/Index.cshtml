@{ ViewData["Title"] = "Modern clinic care"; ViewData["BodyClass"] = "index-page"; }

<section id="hero" class="hero section">
    <div class="container" data-aos="fade-up"><div class="row align-items-center">
        <div class="col-lg-6"><div class="hero-content">
            <div class="trust-badges mb-4"><div class="badge-item"><i class="bi bi-shield-check"></i><span>Secure records</span></div><div class="badge-item"><i class="bi bi-clock"></i><span>Easy booking</span></div></div>
            <h1>Better clinic care, <span class="highlight">all in one place.</span></h1>
            <p class="hero-description">ArabClinic brings patients, appointments, doctors, and departments together in one clear and dependable experience.</p>
            <div class="hero-actions"><a asp-controller="Appointments" asp-action="Create" class="btn btn-primary">Book an appointment</a><a asp-controller="Patients" asp-action="Index" class="btn btn-outline"><i class="bi bi-people me-2"></i>Manage patients</a></div>
        </div></div>
        <div class="col-lg-6"><div class="hero-visual"><div class="main-image"><img src="~/assets/img/health/staff-10.webp" alt="ArabClinic care team" class="img-fluid" /><div class="floating-card appointment-card"><div class="card-icon"><i class="bi bi-calendar-check"></i></div><div class="card-content"><h6>Quick booking</h6><p>Choose your doctor</p><small>Confirm in minutes</small></div></div></div></div></div>
    </div></div>
</section>

<section class="section light-background"><div class="container"><div class="section-title" data-aos="fade-up"><h2>Your clinic workspace</h2><p>Start with the core modules in our project plan.</p></div><div class="row gy-4">
    <div class="col-lg-3 col-md-6"><a asp-controller="Patients" asp-action="Index" class="feature-tile"><i class="bi bi-people"></i><h3>Patients</h3><p>Profiles, history, and contact details.</p><span>Open module <i class="bi bi-arrow-right"></i></span></a></div>
    <div class="col-lg-3 col-md-6"><a asp-controller="Doctors" asp-action="Index" class="feature-tile"><i class="bi bi-person-badge"></i><h3>Doctors</h3><p>Specialties, schedules, and availability.</p><span>Meet the team <i class="bi bi-arrow-right"></i></span></a></div>
    <div class="col-lg-3 col-md-6"><a asp-controller="Appointments" asp-action="Index" class="feature-tile"><i class="bi bi-calendar2-check"></i><h3>Appointments</h3><p>Book and review upcoming visits.</p><span>View schedule <i class="bi bi-arrow-right"></i></span></a></div>
    <div class="col-lg-3 col-md-6"><a asp-controller="Departments" asp-action="Index" class="feature-tile"><i class="bi bi-hospital"></i><h3>Departments</h3><p>Organize care by specialty.</p><span>Explore care <i class="bi bi-arrow-right"></i></span></a></div>
</div></div></section>

<section class="call-to-action section accent-background"><div class="container"><div class="row align-items-center"><div class="col-lg-8"><h2>Need help choosing the right care?</h2><p>Book a general consultation and our team will guide you to the right department.</p></div><div class="col-lg-4 text-lg-end"><a asp-controller="Appointments" asp-action="Create" class="cta-btn">Start booking</a></div></div></div></section>
