@{ ViewData["Title"] = "Appointments"; ViewData["BodyClass"] = "appointment-page"; }
<partial name="_PageTitle" model='("Appointments", "Review the clinic schedule and book care with the right department.")' />
<section class="section"><div class="container">
@if (TempData["AppointmentSubmitted"] is true) { <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>Your appointment request was received. Our team will contact you to confirm it.</div> }
<div class="workspace-toolbar"><div><h2>Upcoming schedule</h2><p>Appointments will appear here after persistence is connected.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-calendar-plus me-2"></i>Book appointment</a></div>
<div class="empty-state"><div class="empty-icon"><i class="bi bi-calendar2-week"></i></div><h3>No scheduled appointments</h3><p>Use the booking form to send the first appointment request.</p><a asp-action="Create" class="btn btn-outline-primary">Book now</a></div>
</div></section>
